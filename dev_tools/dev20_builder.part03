"$CONFIG_DIR/lmkd-test/postboot.env"\n', 'LMKD_RELOAD_EVIDENCE="$CONFIG_DIR/lmkd-reload.env"\n', 'action vars')
new_actions = r'''show_lmkd_evidence() {
  msg ""
  msg "LMKD reload evidence"
  msg "----------------------------------------"
  if [ -r "$LMKD_RELOAD_EVIDENCE" ]; then
    cat "$LMKD_RELOAD_EVIDENCE" 2>/dev/null || true
  else
    msg "No LMKD reload evidence recorded yet."
  fi
  msg "----------------------------------------"
}

set_lmkd_reload() {
  cur="$(cfg_get LMKD_SWAP_LOW_RELOAD)"
  case "$cur" in 1) idx=1 ;; *) idx=0 ;; esac
  ui_menu3 "LMKD 1% reload" "Disabled (stock)" "EXPERIMENTAL 1%" "Back" "$idx"
  [ "$UI_REASON" = "timeout" ] && return 0
  apply="$MODDIR/tools/zram/apply-zram-100p.sh"
  tmp="$CONFIG_DIR/lmkd-action.$$.log"
  case "$UI_INDEX" in
    0)
      cfg_set LMKD_SWAP_LOW_RELOAD 0
      cfg_set LMKD_SWAP_LOW_RISK_ACK none
      cfg_set LAST_LMKD_SWAP_LOW_RELOAD disabled
      if [ -s "$apply" ]; then
        MODDIR="$MODDIR" ZRAM_CONFIG_FILE="$CONFIG_FILE" sh "$apply" lmkd_restore > "$tmp" 2>&1 || true
        tail -n 3 "$tmp" 2>/dev/null | while IFS= read -r line; do msg "$line"; done
      fi
      msg "- LMKD 1% reload: disabled"
    ;;
    1)
      if [ "$(cfg_get ENABLE_ZRAM_100P)" != 1 ]; then
        msg "! Enable ZRAM 100% before this experiment."
        rm -f "$tmp" 2>/dev/null || true
        sleep 2
        return 0
      fi
      cfg_set LMKD_SWAP_LOW_RELOAD 1
      cfg_set LMKD_SWAP_LOW_RISK_ACK explicit_user_reload
      cfg_set LAST_LMKD_SWAP_LOW_RELOAD enabled
      if [ -s "$apply" ]; then
        MODDIR="$MODDIR" ZRAM_CONFIG_FILE="$CONFIG_FILE" sh "$apply" manual > "$tmp" 2>&1 || true
        tail -n 4 "$tmp" 2>/dev/null | while IFS= read -r line; do msg "$line"; done
      fi
      msg "! EXPERIMENTAL LMKD 1% reload enabled."
      msg "! AOSP reinit first; full restart only as fallback."
    ;;
    *) rm -f "$tmp" 2>/dev/null || true; msg "Back."; return 0 ;;
  esac
  rm -f "$tmp" 2>/dev/null || true
  mark_status_dirty
  refresh_status
  show_status
  msg "Back to Advanced."
}

set_zram()'''
s = regex_once(s, r'show_lmkd_evidence\(\) \{.*?\n\}\n\nset_lmkd_early_test\(\) \{.*?\n\}\n\nset_zram\(\)', new_actions, 'action LMKD functions')
s = s.replace('"LMKD early test"', '"LMKD 1% reload"')
s = s.replace('set_lmkd_early_test', 'set_lmkd_reload')
s = s.replace('"LMKD Evidence"', '"LMKD Reload Evidence"')
write('tools/action-dashboard.sh', s)

# Install menu key/name migration while preserving existing menu flow.
s = read('tools/menu/install-options-menu.sh')
for old, new in [
    ('LAST_LMKD_EARLY_SWAP_LOW_TEST', 'LAST_LMKD_SWAP_LOW_RELOAD'),
    ('LMKD_EARLY_SWAP_LOW_TEST', 'LMKD_SWAP_LOW_RELOAD'),
    ('LMKD_EARLY_SWAP_LOW_RISK_ACK', 'LMKD_SWAP_LOW_RISK_ACK'),
    ('apply_lmkd_test', 'apply_lmkd_reload'),
    ('explicit_user_test', 'explicit_user_reload'),
    ('LMKD early test', 'LMKD 1% reload'),
]:
    s = s.replace(old, new)
write('tools/menu/install-options-menu.sh', s)

# Status library: read the consolidated evidence and new config keys.
s = read('tools/debug/status-lib.sh')
new_status = r'''  lmk_test_enabled="$(cfg_get LMKD_SWAP_LOW_RELOAD)"
  lmk_test_ack="$(cfg_get LMKD_SWAP_LOW_RISK_ACK)"
  [ -n "$lmk_test_enabled" ] || lmk_test_enabled=0
  [ -n "$lmk_test_ack" ] || lmk_test_ack=none
  lmk_state_file="$DATA_ROOT/lmkd-reload.env"
  lmk_reload_result="$(kv_get reload_result "$lmk_state_file")"
  lmk_reload_method="$(kv_get reload_method "$lmk_state_file")"
  lmk_property_after="$(kv_get property_after "$lmk_state_file")"
  lmk_service_after="$(kv_get lmkd_service_after "$lmk_state_file")"
  lmk_icon="$OFF"
  lmk_state=stock_disabled
  lmk_value=stock
  if [ "$lmk_test_enabled" = 1 ] && [ "$lmk_test_ack" = explicit_user_reload ]; then
    lmk_icon="$WARN"
    lmk_state=reload_pending
    lmk_value=reload-pending
    if [ "$lmk_reload_result" = success ] && [ "$lmk_property_after" = 1 ] && [ "$lmk_service_after" = running ]; then
      lmk_icon="$OK"
      lmk_state="reload_verified_${lmk_reload_method:-unknown}"
      lmk_value=1pct-active
    elif [ "$lmk_reload_result" = failed ]; then
      lmk_icon="$BAD"
      lmk_state=reload_failed
      lmk_value=reload-failed
    fi
  fi

'''
s = regex_once(s, r'  lmk_test_enabled=.*?\n\n  case "\$thermal_value"', new_status + '  case "$thermal_value"', 'status LMKD block')
write('tools/debug/status-lib.sh', s)

# Remove helper-specific package exceptions/requirements added by Dev.19.
s = read('dev_tools/build-release-module.sh')
s = s.replace('    tools/lmkd/early-swap-low-test.sh|tools/lmkd/verify-early-swap-low-test.sh) return 1 ;;\n', '')
s = s.replace('  tools/lmkd/early-swap-low-test.sh\n  tools/lmkd/verify-early-swap-low-test.sh\n', '')
write('dev_tools/build-release-module.sh', s)

s = read('dev_tools/verify-release-module.sh')
s = s.replace('  tools/lmkd/early-swap-low-test.sh\n  tools/lmkd/verify-early-swap-low-test.sh\n', '')
s = replace_once(s, '''if grep -E "$banned_regex" "$entries_file" \\
  | grep -Fvx \\
      -e 'tools/lmkd/early-swap-low-test.sh' \\
      -e 'tools/lmkd/verify-early-swap-low-test.sh'; then''', 'if grep -E "$banned_regex" "$entries_file"; then', 'verify banned pipe')
s = s.replace("printf 'PASS lmkd_runtime_helpers_packaged\\n'\n", '')
write('dev_tools/verify-release-module.sh', s)

# Release package regression: assert integration in the existing ZRAM script and absence of helper scripts.
s = read('tests/test-release-package-exclusions.sh')
s = s.replace('lmkd_early="$repo_root/tools/lmkd/early-swap-low-test.sh"\nlmkd_verify="$repo_root/tools/lmkd/verify-early-swap-low-test.sh"\n', '')
s = regex_once(s, r'\nsh -n "\$lmkd_early".*?grep -Fq \'indirect_timing_only\' "\$lmkd_verify"\n', '\nsh -n "$repo_root/tools/zram/apply-zram-100p.sh"\ngrep -Fq \'setprop lmkd.reinit 1\' "$repo_root/tools/zram/apply-zram-100p.sh" || grep -Fq \'"$SETPROP_BIN" lmkd.reinit 1\' "$repo_root/tools/zram/apply-zram-100p.sh"\ngrep -Fq \'ctl.restart lmkd\' "$repo_root/tools/zram/apply-zram-100p.sh"\n', 'release test source checks')
s = s.replace("unzip -Z1 \"$out_a\" | grep -Fxq 'tools/lmkd/early-swap-low-test.sh'\nunzip -Z1 \"$out_a\" | grep -Fxq 'tools/lmkd/verify-early-swap-low-test.sh'\n", '')
s = s.replace("unzip -p \"$out_a\" post-fs-data.sh | grep -Fq 'tools/lmkd/early-swap-low-test.sh'\nunzip -p \"$out_a\" service.sh | grep -Fq 'tools/lmkd/verify-early-swap-low-test.sh'\nunzip -p \"$out_a\" tools/lmkd/early-swap-low-test.sh | grep -Fq 'ro.lmk.swap_free_low_percentage'\nunzip -p \"$out_a\" tools/lmkd/verify-early-swap-low-test.sh | grep -Fq 'indirect_timing_only'\n", "if unzip -Z1 \"$out_a\" | grep -q '^tools/lmkd/'; then\n  printf '%s\\n' 'FAIL obsolete_lmkd_helper_packaged'\n  exit 1\nfi\nunzip -p \"$out_a\" tools/zram/apply-zram-100p.sh | grep -Fq 'ro.lmk.swap_free_low_percentage'\nunzip -p \"$out_a\" tools/zram/apply-zram-100p.sh | grep -Fq 'lmkd.reinit'\nunzip -p \"$out_a\" tools/zram/apply-zram-100p.sh | grep -Fq 'ctl.restart'\n")
s = s.replace("grep -q 'PASS lmkd_runtime_helpers_packaged' \"$log_a\"\ngrep -q 'PASS lmkd_runtime_helpers_packaged' \"$log_b\"\n", '')
s = s.replace("printf '%s\\n' 'PASS lmkd_runtime_helpers_shipped_and_wired'\n", "printf '%s\\n' 'PASS lmkd_reload_consolidated_in_zram_script'\n")
write('tests/test-release-package-exclusions.sh', s)

# Replace Dev.19 LMKD regression content with a Dev.20 consolidated fixture while retaining path for current workflow compatibility.
test = r'''#!/usr/bin/env bash
set -euo pipefail
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
apply="$root/tools/zram/apply-zram-100p.sh"
post_fs="$root/post-fs-data.sh"
service="$root/service.sh"
action="$root/tools/action-dashboard.sh"
menu="$root/tools/menu/install-options-menu.sh"
status="$root/tools/debug/status-lib.sh"
module_prop="$root/module.prop"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/mod/tools/zram" "$tmp/mod/tools" "$tmp/state" "$tmp/bin"
printf '%s\n' test-boot > "$tmp/boot_id"
printf '%s\n' '12.00 34.00' > "$tmp/uptime"
printf '%s\n' 1 > "$tmp/property"
printf '%s\n' running > "$tmp/service"
printf '%s\n' 100 > "$tmp/pid"
: > "$tmp/reinit"
printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' 'case "${1:-}" in' '  ro.lmk.swap_free_low_percentage) cat "$PROP_FILE" ;;' '  init.svc.lmkd) cat "$SERVICE_FILE" ;;' '  lmkd.reinit) cat "$REINIT_FILE" ;;' '  *) printf "\\n" ;;' 'esac' > "$tmp/bin/getprop"
printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' 'key="${1:-}"; value="${2:-}"' 'case "$key" in' '  lmkd.reinit) printf "%s\\n" "$value" > "$REINIT_FILE"; : > "$REINIT_FILE" ;;' '  ctl.restart) printf "%s\\n" 200 > "$PID_FILE"; printf "%s\\n" running > "$SERVICE_FILE" ;;' 'esac' > "$tmp/bin/setprop"
printf '%s\n' '#!/usr/bin/env bash' 'cat "$PID_FILE"' > "$tmp/bin/pidof"
printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$tmp/bin/stop"
printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$tmp/bin/start"
printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$tmp/bin/sleep"
printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' 'case "$1" in' '  -n) printf "%s\\n" "$3" > "$PROP_FILE" ;;' '  -d) : > "$PROP_FILE" ;;' '  *) exit 2 ;;' 'esac' > "$tmp/mod/tools/resetprop-rs"
printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$tmp/mod/tools/zram/config-normalize.sh"
chmod +x "$tmp/bin/"* "$tmp/mod/tools/resetprop-rs" "$tmp/mod/tools/zram/config-normalize.sh"

run_apply() {
  MODDIR="$tmp/mod" ZRAM_CONFIG_FILE="$tmp/config.env" \
  LMKD_GETPROP_BIN="$tmp/bin/getprop" LMKD_SETPROP_BIN="$tmp/bin/setprop" \
  LMKD_PIDOF_BIN="$tmp/bin/pidof" LMKD_STOP_BIN="$tmp/bin/stop" LMKD_START_BIN="$tmp/bin/start" LMKD_SLEEP_BIN="$tmp/bin/sleep" \
  LMKD_BOOT_ID_FILE="$tmp/boot_id" LMKD_UPTIME_FILE="$tmp/uptime" \
  PROP_FILE="$tmp/property" SERVICE_FILE="$tmp/service" REINIT_FILE="$tmp/reinit" PID_FILE="$tmp/pid" \
  sh "$apply" "$1"
}

bash -n "$apply"; bash -n "$post_fs"; bash -n "$service"; bash -n "$action"; bash -n "$menu"; bash -n "$status"
printf '%s\n' 'ENABLE_ZRAM_100P=1' 'ZRAM_RISK_ACK=explicit_user_enable' 'LMKD_SWAP_LOW_RELOAD=1' 'LMKD_SWAP_LOW_RISK_ACK=explicit_user_reload' 'ZRAM_RESTART_MMD=0' > "$tmp/config.env"
printf '%s\n' 10 > "$tmp/property"
run_apply manual > "$tmp/apply.log"
grep -Fq 'LMKD_RELOAD result=success method=aosp_reinit' "$tmp/apply.log"
grep -Fxq 'reload_result=success' "$tmp/lmkd-reload.env"
grep -Fxq 'reload_method=aosp_reinit' "$tmp/lmkd-reload.env"
grep -Fxq 'property_after=1' "$tmp/lmkd-reload.env"
grep -Fxq 'LMKD_SWAP_LOW_ORIGINAL_VALUE=10' "$tmp/config.env"

printf '%s\n' 'ENABLE_ZRAM_100P=1' 'ZRAM_RISK_ACK=explicit_user_enable' 'LMKD_SWAP_LOW_RELOAD=0' 'LMKD_SWAP_LOW_RISK_ACK=none' 'LMKD_SWAP_LOW_ORIGINAL_VALUE=10' 'ZRAM_RESTART_MMD=0' > "$tmp/config.env"
run_apply lmkd_restore > "$tmp/restore.log"
grep -Fxq 10 "$tmp/property"
grep -Fq 'RESULT: ZRAM_APPLY_DONE mode=lmkd_restore' "$tmp/restore.log"

! grep -Fq 'tools/lmkd/' "$post_fs"
! grep -Fq 'tools/lmkd/' "$service"
grep -Fq 'update_manager_badges' "$service"
grep -Fq 'dynamic_description_readback_missing' "$service"
grep -Fq 'LMKD 1% reload' "$action"
grep -Fq 'LMKD Reload Evidence' "$action"
grep -Fq 'LMKD 1% reload' "$menu"
grep -Fq 'LMKD_SWAP_LOW_RELOAD' "$status"
grep -Fq 'version=2.0.0-alpha.3-dev.20' "$module_prop"
grep -Fq 'versionCode=1016231' "$module_prop"
[[ ! -e "$root/tools/lmkd/early-swap-low-test.sh" ]]
[[ ! -e "$root/tools/lmkd/verify-early-swap-low-test.sh" ]]

printf '%s\n' 'PASS dev20_lmkd_consolidated_in_zram_script'
printf '%s\n' 'PASS dev20_aosp_reinit_first_with_restart_fallback'
printf '%s\n' 'PASS dev20_runtime_restore_path'
printf '%s\n' 'PASS dev20_legacy_helpers_removed'
printf '%s\n' 'PASS dev20_manager_badge_retry_readback'
printf '%s\n' 'RESULT: PIXEL_THERMAL_DEV20_LMKD_RELOAD_PASS'
'''
write('tests/test-dev19-lmkd-early-test.sh', test)

# Current docs.
s = read('README.md')
s = s.replace('`2.0.0-alpha.3-dev.19` / `1016230` | Unreleased vNext source with guarded LMKD early-boot test', '`2.0.0-alpha.3-dev.20` / `1016231` | Unreleased vNext source with consolidated LMKD reload and badge reliability fix')
section = r'''## vNext LMKD 1% reload experiment

Dev.20 replaces the ineffective post-fs-data experiment with one consolidated function inside `tools/zram/apply-zram-100p.sh`.

When explicitly enabled with ZRAM 100p, the module sets:

```text
ro.lmk.swap_free_low_percentage=1
```

It then prefers Android's targeted `lmkd.reinit` contract. If that trigger is unavailable or does not acknowledge, it falls back to a verified `ctl.restart lmkd` / stop-start cycle. The same path works during boot and when toggled from Magisk Action.

Safety contract:

- disabled by default;
- requires ZRAM 100p and explicit acknowledgement;
- no separate LMKD runtime helper scripts;
- records property readback, reload method, service state and PID evidence;
- remembers the original property for a controlled runtime restore;
- does not claim a direct internal-value probe beyond the AOSP reinit/start contract.

Dev.20 also verifies the final P/T/Z/L manager description after boot and retries the write when readback is still static.

'''
s = regex_once(s, r'## vNext LMKD early-boot test\n.*?\n## Installation', section + '## Installation', 'README LMKD section')
s = s.replace('experimental LMKD early test;', 'experimental LMKD 1% reload;')
write('README.md', s)

notes = '''# 2.0.0-alpha.3-dev.20\n\nUnreleased Dynamic V2 source; no tag, release asset, or update-channel change.\n\n- Replaces the ineffective post-fs-data LMKD experiment with a consolidated function in `apply-zram-100p.sh`.\n- Sets `ro.lmk.swap_free_low_percentage=1` only for the explicit ZRAM-linked experiment.\n- Uses AOSP `lmkd.reinit` first and a verified daemon restart only as fallback.\n- Supports both boot-time application and immediate Action-dashboard reload.\n- Removes the two Dev.19 LMKD runtime helper scripts and their package exceptions.\n- Records property, method, service and PID evidence in one state file.\n- Adds controlled restoration of the remembered stock property.\n- Fixes automatic P/T/Z/L badges with a final post-Bootguard write, retry and module.prop readback.\n- Credits Harish / Codecity001 for the working live-reload method and script-consolidation direction.\n'''
write('release-notes/2.0.0-alpha.3-dev.20.md', notes)
s = read('CHANGELOG.md')
write('CHANGELOG.md', notes + '\n' + s)

s = read('CREDITS.md')
needle = '  - profile-layout refactor concept and mockup reference used by the manager/menu work.\n'
addition = '  - Dev.20 LMKD live-reload validation: moving the 1-percent property into the ZRAM apply path, reloading LMKD after the write for boot and Action use, and consolidating the feature into fewer runtime scripts.\n'
s = replace_once(s, needle, needle + addition, 'credits Harish')
write('CREDITS.md', s)

# Remove obsolete runtime helpers.
for path in ['tools/lmkd/early-swap-low-test.sh', 'tools/lmkd/verify-early-swap-low-test.sh']:
    p(path).unlink(missing_ok=True)
try:
    p('tools/lmkd').rmdir()
except OSError:
    pass

# Update obvious current-version assertions without touching historical release notes.
for path in p('tests').glob('*.sh'):
    text = path.read_text()
    text = text.replace('version=2.0.0-alpha.3-dev.19', 'version=2.0.0-alpha.3-dev.20')
    text = text.replace('versionCode=1016230', 'versionCode=1016231')
    path.write_text(text)

# Runtime old-key references are allowed only in the migration block.
for path in [p('post-fs-data.sh'), p('service.sh'), p('tools/action-dashboard.sh'), p('tools/menu/install-options-menu.sh'), p('tools/debug/status-lib.sh')]:
    text = path.read_text()
    if 'LMKD_EARLY_SWAP_LOW' in text or 'tools/lmkd/' in text:
        raise SystemExit(f'obsolete LMKD runtime reference remains: {path}')

# Syntax and focused tests.
for path in ['post-fs-data.sh', 'service.sh', 'tools/zram/apply-zram-100p.sh', 'tools/zram/config-normalize.sh', 'tools/action-dashboard.sh', 'tools/menu/install-options-menu.sh', 'tools/debug/status-lib.sh']:
    subprocess.run(['bash', '-n', path], check=True)
subprocess.run(['bash', 'tests/test-dev19-lmkd-early-test.sh'], check=True)
subprocess.run(['bash', 'tests/test-release-package-exclusions.sh'], check=True)
print('RESULT: DEV20_BUILDER_PASS')
